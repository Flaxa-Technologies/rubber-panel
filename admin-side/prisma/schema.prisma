// Rubber Panel — Admin Side Prisma Schema (v5, SQLite)
// Enums are represented as String for SQLite compatibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER ─────────────────────────────────────────────────────────────────────
// role: SUPER_ADMIN | ADMIN | STAFF | USER
// status: ACTIVE | SUSPENDED | PENDING

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  role          String    @default("USER")
  status        String    @default("ACTIVE")
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  lastLoginIp   String?

  servers       Server[]
  subuserServers ServerSubuser[]
  sessions      Session[]
  auditLogs     AuditLog[]  @relation("ActorLogs")
  apiKeys       APIKey[]
  resourceQuota UserResourceQuota?
  gdriveToken   UserGoogleDriveToken?
  customDomainLimit Int?      @default(-1) // -1 = Inherit Global Default, 0 = Disabled, >0 = Custom Limit
  subdomains    Subdomain[]

  @@map("users")
}

// ─── SESSIONS ─────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── NODES ───────────────────────────────────────────────────────────────────
// status: ONLINE | OFFLINE | DEGRADED | MAINTENANCE

model Node {
  id              String      @id @default(uuid())
  name            String
  fqdn            String
  port            Int         @default(8080)
  location        String?
  description     String?
  status          String      @default("OFFLINE")
  authToken       String      @unique
  maintenanceMode Boolean     @default(false)
  agentVersion    String?
  lastHeartbeat   DateTime?

  maxCpu          Int?
  maxRam          Int?
  maxDisk         Int?
  portRangeStart  Int?
  portRangeEnd    Int?

  // Node Boot & Cryo-Sleep Startup Policy
  autoStartServersOnBoot     Boolean   @default(false)
  bootCryoSleepMode          String    @default("CRYO_HIBERNATE_ALL") // "CRYO_HIBERNATE_ALL" | "RESTORE_PREVIOUS" | "DO_NOTHING"
  bootGracePeriodSeconds     Int       @default(15)
  maxConcurrentBootStarts    Int       @default(3)
  bootStartupDelaySeconds    Int       @default(5)

  cpuUsage        Float?
  ramUsage        Float?
  diskUsage       Float?
  networkRx       Float?
  networkTx       Float?

  // Hardware Host & Storage Telemetry
  hostTotalRam    Int?        // Total Physical Hardware RAM (MB)
  hostUsedRam     Int?        // Total Host RAM Used across OS by all processes (MB)
  hostTotalDisk   Int?        // Total Filesystem Disk Size (MB)
  hostUsedDisk    Int?        // Total Host Disk Used across OS (MB)
  serversUsedDisk Int?        // Disk space used by /var/rubber-panel/servers (MB)
  serversUsedRam  Int?        // Actual RAM used by active containers (MB)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  servers         Server[]
  allocations     Allocation[]
  sourceTransfers ServerTransfer[] @relation("TransferSourceNode")
  targetTransfers ServerTransfer[] @relation("TransferTargetNode")
  javaVersions    JavaVersion[]
  containerImages ContainerImage[]
  databaseHosts   DatabaseHost[]

  @@map("nodes")
}

// ─── ALLOCATIONS ─────────────────────────────────────────────────────────────

model Allocation {
  id         String   @id @default(uuid())
  nodeId     String
  ip         String
  port       Int
  alias      String?
  assigned   Boolean  @default(false)
  disabled   Boolean  @default(false)
  serverId   String?

  node       Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  server     Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())

  @@unique([nodeId, ip, port])
  @@map("allocations")
}

// ─── SERVERS ─────────────────────────────────────────────────────────────────
// status: RUNNING | STOPPED | STARTING | STOPPING | INSTALLING | CRASHED | OFFLINE

model Server {
  id              String    @id @default(uuid())
  name            String
  ownerId         String
  nodeId          String
  status          String    @default("OFFLINE")
  suspended       Boolean   @default(false)

  ram             Int
  cpu             Int
  disk            Int
  swap            Int       @default(0)

  softwareId        String?
  softwareVersionId String?
  templateId        String?

  allowedPaths        String    @default("[\"/plugins\",\"/mods\",\"/config\",\"/world\"]")
  protectedPaths      String    @default("[\"/server.jar\",\"/start.sh\",\"/rubber-panel\"]")
  blockedUploadPaths  String    @default("[]")
  allowNodeTransfer   Boolean   @default(false)
  allowChangeSoftware Boolean   @default(true)
  allowChangeVersion  Boolean   @default(true)
  allowEditStartup    Boolean   @default(true)
  allowRemoteTransfer Boolean   @default(true)

  // Billing, Lifecycle & Suspension
  expiresAt                DateTime?
  gracePeriodDays          Int       @default(3)
  autoSuspendOnExpiry      Boolean   @default(true)
  autoDeleteOnGraceExpiry  Boolean   @default(false)
  suspensionReason         String?
  quotaId                  String?

  // Base Subscription Resources vs Extra Quota Boosts
  baseRam                  Int       @default(1024)
  baseCpu                  Int       @default(100)
  baseDisk                 Int       @default(5120)
  extraRam                 Int       @default(0)
  extraCpu                 Int       @default(0)
  extraDisk                Int       @default(0)
  isCreatedFromQuota       Boolean   @default(false)

  // Cloud Backups (Google Drive)
  allowGoogleDriveBackups  Boolean   @default(true)
  gdriveRetentionCount     Int       @default(3)
  gdriveAutoSchedule       String?
  gdriveExcludePaths       String?

  // Cryo-Sleep (0-RAM Hibernation & Auto Wake-on-Ping)
  cryoSleepEnabled         Boolean   @default(false)
  cryoSleepIdleMinutes     Int       @default(10)
  cryoSleepCustomMotdAllowed Boolean @default(true)
  cryoSleepMotd            String?
  autoStartOnBoot          Boolean   @default(false)

  // Code Sandbox / Cloud IDE (GitHub Codespaces-like)
  isSandbox                Boolean   @default(false)
  sandboxDailyHoursLimit   Int?      @default(0) // 0 = Unlimited, >0 = Max Hours Per Day
  sandboxUsedMinutesToday  Int       @default(0)
  sandboxAutoShutdownMinutes Int     @default(30) // 0 = Disabled, >0 = Auto-shutdown idle minutes
  sandboxLastUsedDate      String?   // "YYYY-MM-DD"
  sandboxPassword          String?   // Web IDE Access Password
  sandboxRuntime           String?   @default("fullstack") // "nodejs" | "python" | "rust" | "golang" | "java" | "fullstack" | "universal"

  uuid            String    @unique @default(uuid())
  internalPort    Int?
  dockerId        String?
  startupCommand  String?
  serverType      String    @default("MINECRAFT") // "MINECRAFT" | "NODEJS"
  nodeVersion     String?   @default("20")
  securityProtection Boolean @default(true)
  securitySuspendedUntil DateTime?
  securityQuarantineReason String?
  javaVersion     String?   @default("21")
  javaVersionId   String?
  customImageId   String?
  environment     String    @default("{}")

  // Custom Subdomains (Individual SRV Records)
  customDomainLimit        Int?      @default(-1) // -1 = Inherit Global Default, 0 = Disabled, >0 = Custom Limit

  // SFTP & Remote Access (Pterodactyl-style)
  sftpEnabled              Boolean   @default(true)
  sftpPort                 Int       @default(2022)

  // MySQL Databases (Pterodactyl-style)
  databaseLimit            Int       @default(0) // 0 = disabled, >0 = max databases allowed

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id])
  node            Node              @relation(fields: [nodeId], references: [id])
  software        Software?         @relation(fields: [softwareId], references: [id])
  softwareVersion SoftwareVersion?  @relation(fields: [softwareVersionId], references: [id])
  template        Template?         @relation(fields: [templateId], references: [id])
  quota           UserResourceQuota? @relation(fields: [quotaId], references: [id], onDelete: SetNull)
  javaVersionRel  JavaVersion?      @relation(fields: [javaVersionId], references: [id], onDelete: SetNull)
  customImage     ContainerImage?   @relation(fields: [customImageId], references: [id], onDelete: SetNull)
  allocations     Allocation[]
  backups         Backup[]
  subusers        ServerSubuser[]
  schedules       Schedule[]
  webhooks        ServerWebhook[]
  transfers       ServerTransfer[]
  subdomains      Subdomain[]
  databases       ServerDatabase[]

  @@map("servers")
}

// ─── USER RESOURCE QUOTAS ───────────────────────────────────────────────────
// onExpireAction: SUSPEND_SERVERS | FREEZE_SCALE | DELETE_SERVERS | NOTIFY_ONLY

model UserResourceQuota {
  id                  String    @id @default(uuid())
  userId              String    @unique
  name                String    @default("Custom Resource Pool")

  maxRam              Int       @default(4096)  // MB
  maxCpu              Int       @default(200)   // %
  maxDisk             Int       @default(20480) // MB
  maxServers          Int       @default(3)     // Max servers count
  maxBackups          Int       @default(5)     // Max backups per server
  maxAllocations      Int       @default(3)     // Max extra ports/allocations

  allowServerCreation Boolean   @default(false) // Toggle for user server self-creation
  isSuspended         Boolean   @default(false) // Manual or auto quota freeze
  suspendedReason     String?

  expiresAt           DateTime? // Billing renewal / expiration timestamp
  gracePeriodDays     Int       @default(3)
  onExpireAction      String    @default("SUSPEND_SERVERS")

  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  servers             Server[]

  @@map("user_resource_quotas")
}

// ─── NODE TRANSFERS ─────────────────────────────────────────────────────────
// status: PENDING | PREPARING | ARCHIVING | TRANSFERRING | EXTRACTING | CONFIGURING | COMPLETED | FAILED | CANCELLED

model ServerTransfer {
  id                 String    @id @default(uuid())
  serverId           String
  sourceNodeId       String
  targetNodeId       String
  targetAllocationId String?
  status             String    @default("PENDING")
  progress           Int       @default(0)
  currentStep        String?
  speedBytesPerSec   Int?
  totalBytes         BigInt?
  transferredBytes   BigInt?
  options            String    @default("{}")
  error              String?
  initiatedBy        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  server             Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  sourceNode         Node      @relation("TransferSourceNode", fields: [sourceNodeId], references: [id])
  targetNode         Node      @relation("TransferTargetNode", fields: [targetNodeId], references: [id])

  @@map("server_transfers")
}

// ─── WEBHOOKS / CONNECTIONS ──────────────────────────────────────────────────

model ServerWebhook {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  url         String
  secret      String?
  events      String   @default("[\"server.start\",\"server.stop\",\"server.crash\"]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("server_webhooks")
}

// ─── SUBUSERS / COLLABORATORS ───────────────────────────────────────────────

model ServerSubuser {
  id          String   @id @default(uuid())
  serverId    String
  userId      String
  roleName    String   @default("Custom")
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("server_subusers")
}

// ─── SCHEDULES / AUTOMATIONS ────────────────────────────────────────────────

model Schedule {
  id             String         @id @default(uuid())
  serverId       String
  name           String
  cron           String         @default("0 0 * * *")
  enabled        Boolean        @default(true)
  onlyWhenOnline Boolean        @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  server         Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tasks          ScheduleTask[]

  @@map("schedules")
}

model ScheduleTask {
  id             String    @id @default(uuid())
  scheduleId     String
  sequence       Int       @default(1)
  action         String    @default("COMMAND")
  payload        String    @default("")
  timeOffset     Int       @default(0)
  createdAt      DateTime  @default(now())

  schedule       Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_tasks")
}

// ─── SOFTWARE ────────────────────────────────────────────────────────────────
// type: VANILLA | PAPER | SPIGOT | FABRIC | FORGE | PURPUR | BUNGEECORD | VELOCITY | CUSTOM

model Software {
  id          String            @id @default(uuid())
  name        String            @unique
  type        String
  description String?
  logoUrl     String?
  createdAt   DateTime          @default(now())

  versions    SoftwareVersion[]
  servers     Server[]

  @@map("software")
}

model SoftwareVersion {
  id           String   @id @default(uuid())
  softwareId   String
  version      String
  buildNumber  String?
  downloadUrl  String?
  releaseDate  DateTime?
  isStable     Boolean  @default(true)
  createdAt    DateTime @default(now())

  software     Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  servers      Server[]

  @@unique([softwareId, version])
  @@map("software_versions")
}

// ─── TEMPLATES ───────────────────────────────────────────────────────────────

model Template {
  id             String   @id @default(uuid())
  name           String
  description    String?
  category       String   @default("MINECRAFT") // "MINECRAFT" | "CUSTOM" | "COMMUNITY"
  softwareType   String?  // e.g. "PAPER", "FABRIC", "PUMPKIN"
  softwareName   String?  // e.g. "Paper", "Fabric", "Pumpkin"
  version        String?  // e.g. "1.21.4"
  startupCmd     String?
  environment    String   @default("{}")
  dockerImage    String?
  allowedPaths   String   @default("[\"/plugins\",\"/mods\",\"/config\",\"/world\"]")
  protectedPaths String   @default("[\"/server.jar\",\"/start.sh\"]")
  zipPath        String?  // path to uploaded .zip archive
  zipSize        Int?     // bytes
  tags           String   @default("[]") // JSON string array
  isOfficial     Boolean  @default(false)
  defaultRam     Int      @default(1024)
  defaultCpu     Int      @default(100)
  defaultDisk    Int      @default(5120)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  servers        Server[]

  @@map("templates")
}

// ─── BACKUPS ─────────────────────────────────────────────────────────────────
// status: PENDING | IN_PROGRESS | COMPLETED | FAILED

model Backup {
  id             String   @id @default(uuid())
  serverId       String
  name           String
  status         String   @default("PENDING")
  storageType    String   @default("LOCAL") // LOCAL | GOOGLE_DRIVE | BOTH
  size           Int?
  checksum       String?
  nodeBackupPath String?
  gdriveFileId   String?
  gdriveWebUrl   String?
  excludePaths   String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("backups")
}

// ─── USER GOOGLE DRIVE TOKENS ────────────────────────────────────────────────
model UserGoogleDriveToken {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  accountEmail String?
  accountName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_gdrive_tokens")
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── API KEYS ─────────────────────────────────────────────────────────────────

model APIKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  permissions String    @default("[]")
  lastUsed    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  targetId   String?
  result     String   @default("SUCCESS")
  ipAddress  String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── JAVA VERSIONS ────────────────────────────────────────────────────────────

model JavaVersion {
  id          String    @id @default(uuid())
  name        String    // e.g. "Java 21 (LTS)"
  version     String    // e.g. "21"
  dockerImage String?   // optional image e.g. "itzg/minecraft-server:java21"
  binaryPath  String?   // optional path e.g. "/usr/lib/jvm/java-21-openjdk/bin/java"
  isDefault   Boolean   @default(false)
  nodeId      String?   // null for all nodes globally, or specific node id
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  node        Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  servers     Server[]

  @@map("java_versions")
}

// ─── CONTAINER IMAGES & MULTI-RUNTIME ────────────────────────────────────────

model ContainerImage {
  id             String    @id @default(uuid())
  name           String    // e.g. "Python 3.12 (Alpine)", "Rust 1.80", "MySQL 8.0"
  category       String    @default("RUNTIME") // "RUNTIME" | "DATABASE" | "WEB" | "CUSTOM"
  dockerImage    String    // e.g. "python:3.12-alpine", "rust:1.80-alpine", "mysql:8.0"
  defaultPort    Int       @default(8080)
  internalPort   Int       @default(8080)
  defaultStartup String?   // e.g. "python -u main.py", "cargo run --release", "docker-entrypoint.sh mysqld"
  environment    String    @default("{}") // JSON default env vars e.g. {"PORT": "8080"}
  description    String?
  icon           String?   // "python" | "rust" | "database" | "code" | "box" | "server"
  nodeId         String?   // null = available on all nodes, or specific node id
  isOfficial     Boolean   @default(false)
  isPulled       Boolean   @default(true)
  lastPulledAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  node           Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  servers        Server[]

  @@map("container_images")
}

// ─── UPDATE RECORDS ───────────────────────────────────────────────────────────
// Tracks update history for admin, user and node sides
// status: PENDING | DOWNLOADING | APPLYING | SUCCESS | FAILED

model UpdateRecord {
  id          String   @id @default(uuid())
  side        String   // "admin" | "user" | "node"
  version     String   // e.g. "v1.2.0"
  status      String   @default("PENDING")
  releaseUrl  String?  // GitHub release page URL
  assetUrl    String?  // Download URL for zip asset
  changelog   String?  // Release notes
  sizeBytes   Int?
  appliedAt   DateTime?
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("update_records")
}

// ─── PUMPKIN RUST MINECRAFT BUILDS ──────────────────────────────────────────
// Tracks rolling nightly builds & stable versions with commit SHAs and digests

model PumpkinBuild {
  id              String    @id @default(uuid())
  versionId       String    @unique // e.g. "pumpkin-nightly-9e9f1b5" or "pumpkin-v0.1.0"
  commitSha       String    // e.g. "9e9f1b5"
  tag             String    @default("nightly") // "nightly" | "v0.1.0"
  versionSequence String    @default("1.0.0") // sequence e.g. "1.0.0", "1.0.1", "1.0.2"
  javaVersion     String?   @default("1.21.4")
  bedrockVersion  String?   @default("1.21.50")
  generatedAt     DateTime?
  publishedAt     DateTime?
  isNightly       Boolean   @default(true)
  isLatest        Boolean   @default(false)
  isOutdated      Boolean   @default(false)
  x64Url          String?
  x64Sha256       String?
  x64Size         Int?
  arm64Url        String?
  arm64Sha256     String?
  arm64Size       Int?
  syncedNodes     String    @default("[]") // JSON string array of Node IDs that have cached this binary
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("pumpkin_builds")
}

// ─── DOMAINS (CLOUDFLARE DNS SRV MANAGEMENT) ──────────────────────────────
// provider: CLOUDFLARE | MANUAL
// status: ACTIVE | PENDING | ERROR | DISABLED

model Domain {
  id             String      @id @default(uuid())
  name           String      @unique // e.g. "example.com"
  provider       String      @default("CLOUDFLARE")
  apiToken       String      // Cloudflare API Token
  zoneId         String      // Cloudflare Zone ID
  status         String      @default("ACTIVE")
  isVerified     Boolean     @default(false)
  lastVerifiedAt DateTime?
  lastSyncError  String?
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subdomains     Subdomain[]

  @@map("domains")
}

// ─── SUBDOMAINS (MINECRAFT INDIVIDUAL SRV RECORDS) ────────────────────────
// status: ACTIVE | PENDING | ERROR | ORPHANED

model Subdomain {
  id             String    @id @default(uuid())
  domainId       String
  serverId       String
  userId         String
  subdomain      String    // e.g. "play", "survival"
  fqdn           String    @unique // e.g. "play.example.com"
  srvRecordId    String?   // Cloudflare SRV Record ID
  targetRecordId String?   // Cloudflare Target A Record ID
  targetHost     String    // e.g. "node-1.example.com"
  port           Int       // Minecraft Primary Port e.g. 25565
  status         String    @default("ACTIVE")
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  domain         Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([domainId, subdomain])
  @@map("subdomains")
}

// ─── RADAR: NETWORK TRAFFIC & ABUSE MITIGATION ────────────────────────────

model RadarThreshold {
  id                    String   @id @default(uuid())
  serverId              String?  @unique
  nodeId                String?
  maxConnPerIpPerWindow Int      @default(20)
  windowMs              Int      @default(10000)
  banDurationMs         Int      @default(900000) // 15 minutes
  autoMitigate          Boolean  @default(true)
  underAttackMode       Boolean  @default(false)
  underAttackExpiresAt  DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("radar_thresholds")
}

model RadarBan {
  id         String    @id @default(uuid())
  nodeId     String
  serverId   String?
  ip         String
  port       Int?
  reason     String
  country    String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  releasedAt DateTime?
  manual     Boolean   @default(false)

  @@index([nodeId])
  @@index([ip])
  @@map("radar_bans")
}

model RadarSample {
  id            String   @id @default(uuid())
  nodeId        String
  timestamp     DateTime @default(now())
  connsPerSec   Int
  bytesPerSecIn Int
  bytesPerSecOut Int
  activeBans    Int      @default(0)

  @@index([nodeId, timestamp])
  @@map("radar_samples")
}

model TrustedIp {
  id        String   @id @default(uuid())
  ip        String   @unique
  label     String?
  createdAt DateTime @default(now())

  @@map("trusted_ips")
}

model RadarWebhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  secret    String?
  events    String   @default("[\"radar.ban\",\"radar.shield_mode\"]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("radar_webhooks")
}

// ─── SERVER DATABASES (PTERODACTYL-STYLE) ────────────────────────────────────

model ServerDatabase {
  id              String    @id @default(uuid())
  serverId        String
  name            String    // Database name, e.g. "s_81173e26_db1"
  databaseUser    String    // Database username, e.g. "u_81173e26_db1"
  password        String    // Generated password
  host            String    @default("127.0.0.1")
  port            Int       @default(3306)
  connectionsFrom String    @default("%")
  maxConnections  Int       @default(10)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  server          Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@map("server_databases")
}

model DatabaseHost {
  id              String    @id @default(uuid())
  name            String    // e.g. "Primary MySQL Node"
  host            String    @default("127.0.0.1")
  port            Int       @default(3306)
  username        String    @default("root")
  password        String    // Root/Admin password
  nodeId          String?
  node            Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("database_hosts")
}



